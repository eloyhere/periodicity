# ============================================================
#  Periodicity Mathematics — repository ignore rules
# ============================================================

# ---- LaTeX auxiliary / build artifacts ----
# Regenerated by compile.bat; cleaned by clean.bat.
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.synctex.gz
*.fls
*.xdv
*.fdb_latexmk
*.bbl
*.blg
*.bcf
*.run.xml
*.idx
*.ind
*.ilg
*.nav
*.snm
*.vrb
*_biber_tmp/

# ---- Duplicated font set ----
# Each book keeps its own fonts/ directory, because preamble.tex loads the
# CJK/mono faces through the relative path `Path = ./fonts/`. This root-level
# copy is byte-identical to both of them and is not referenced by anything.
/fonts/

# ---- OS / editor cruft ----
Thumbs.db
desktop.ini
.DS_Store
*~
*.swp
